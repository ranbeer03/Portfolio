# Copy to .env.local and fill in from Supabase dashboard → Settings → API.
# The anon key is safe to expose to browsers (RLS is the security boundary);
# the service_role key must NEVER appear here or anywhere in this repo.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
